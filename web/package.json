{
  "name": "luxe-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "luxe.dev, the website for luxe: a coding agent for your terminal",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "smoke": "../scripts/site-check.sh",
    "deploy": "npm run build && wrangler pages deploy dist --branch main",
    "deploy:preview": "npm run build && wrangler pages deploy dist --branch preview",
    "cross": "node ../scripts/site-cross.mjs",
    "cross:built": "npm run build && node ../scripts/site-cross.mjs --built"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/svelte": "^9.1.6",
    "asciinema-player": "^3.18.1",
    "astro": "^7.4.13",
    "svelte": "^5.58.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "pagefind": "^1.6.0",
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.165.0"
  }
}
