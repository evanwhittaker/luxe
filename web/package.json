{
  "name": "luxe-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "luxe.dev \u2014 the website for the Luxe agentic coding harness",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "smoke": "../scripts/site-check.sh",
    "deploy": "npm run build && wrangler pages deploy dist --branch main",
    "deploy:preview": "npm run build && wrangler pages deploy dist --branch preview",
    "cross": "node ../scripts/site-cross.mjs",
    "cross:built": "npm run build && node ../scripts/site-cross.mjs --built"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "asciinema-player": "^3.17.0",
    "astro": "^7.3.8",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "playwright": "^1.64.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.132.0"
  }
}
